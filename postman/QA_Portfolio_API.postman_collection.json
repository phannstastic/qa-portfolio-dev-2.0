        {
          "name": "Submit Contact Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Inquirer\",\n  \"email\": \"inquirer@example.com\",\n  \"subject\": \"Automated QA Collaboration\",\n  \"message\": \"Hello, this is an automated regression test message from Postman.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/contacts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contacts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Message created with unread status', function () {",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.data.status).to.eql('unread');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
