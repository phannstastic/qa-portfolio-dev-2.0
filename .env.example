# Server Environment
NODE_ENV=development
PORT=3000
# SERVER_PORT is automatically provided by PaaS hosts like Silly Development
# SERVER_PORT=25432
# HOST=0.0.0.0

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=qa_portfolio
# Pool connection limit: default 4 (safe for Silly Development free tier max 5 connections)
DB_CONNECTION_LIMIT=4

# Authentication & Security
# Note: In production or when JWT auth is implemented, provide a strong secret key
JWT_SECRET=your_jwt_secret_min_32_chars_placeholder

# Database Seeding Configuration
# Note: SEED_ADMIN_PASSWORD is required when executing 'bun run db:seed'
ADMIN_EMAIL=admin@qa-portfolio.local
SEED_ADMIN_PASSWORD=your_secure_seed_password_here

# E2E Test Database Configuration (Isolated)
# Tests fail-fast if pointing to qa_portfolio_dev or qa_playground_db
E2E_DB_NAME=qa_portfolio_e2e_test

# Email Notification Service (Resend)
# Required for receiving contact form notifications via backend.
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Target email recipient for contact form notifications
CONTACT_TO_EMAIL=rphannfvs@gmail.com
# Sender email address. If domain is not verified yet in Resend, use "irfan.Lab <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=irfan.Lab <onboarding@resend.dev>
